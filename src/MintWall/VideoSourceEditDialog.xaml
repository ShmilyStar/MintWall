<Window x:Class="MintWall.VideoSourceEditDialog"
        x:Name="editor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="在线视频源"
        Background="{StaticResource BrushWindow}"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Height="34" Background="{StaticResource BrushRail}">
                <Grid>
                    <TextBlock Text="{Binding Title, ElementName=editor}"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextDim}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               TextWrapping="NoWrap" />
                    <Button Style="{StaticResource CaptionCloseButton}"
                            ToolTip="关闭"
                            HorizontalAlignment="Right"
                            Width="40"
                            Height="34"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="Cancel_Click">
                        <TextBlock Style="{StaticResource CaptionGlyph}" Text="&#xE8BB;" />
                    </Button>
                </Grid>
            </Border>

            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="填直链视频地址，或返回视频地址的 JSON 接口；播放前会先下载到本地缓存。"
                           Foreground="{StaticResource BrushTextDim}"
                           FontSize="12"
                           Margin="0,0,0,14" />

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock Text="地址" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="解析方式" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding KindOptions, ElementName=editor}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding Kind}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="JSON 字段路径（选填，留空自动识别）" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding JsonFieldPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="4" Margin="0,0,0,10">
                    <TextBlock Text="请求头（每行一条 Key: Value，选填）" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Headers, UpdateSourceTrigger=PropertyChanged}"
                             Height="70"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12" />
                </StackPanel>

                <CheckBox Grid.Row="5"
                          Content="启用这个源"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding Enabled}" />

                <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="取消" IsCancel="True" Width="88" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="保存" Style="{StaticResource AccentButton}" Width="88" Margin="0" Click="Ok_Click" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
