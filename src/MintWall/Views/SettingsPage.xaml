<UserControl x:Class="MintWall.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Height" Value="140" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,16">
        <StackPanel>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                <TextBlock Text="改完即存，下一次换壁纸就会按新设置执行。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="哪些设置是分开的" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Margin="0,6,0,0"
                                   Text="· 壁纸源、壁纸库目录、定时器、壁纸样式：桌面和锁屏都按显示器各一套，在页面顶部选中哪块屏就改哪块屏。"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Margin="0,4,0,0"
                                   Text="· 收藏、入库格式、库上限：所有屏幕共用同一份。"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Margin="0,4,0,0"
                                   Text="· 旧配置里的源和图片已整体归到“桌面 · 第一块屏”，其余屏幕和锁屏从空库开始。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="目录" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="打开数据目录" Margin="0,0,8,0" Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="桌面库" Margin="0,0,8,0" Command="{Binding Desktop.OpenLibraryFolderCommand}" />
                            <Button Content="锁屏库" Command="{Binding Lock.OpenLibraryFolderCommand}" Margin="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="入库格式" Style="{StaticResource SectionTitle}" />
                        <ComboBox ItemsSource="{Binding EncodeOptions}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding Encode}"
                                  Width="320"
                                  HorizontalAlignment="Left"
                                  Margin="0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="接口经常返回 webp，系统壁纸不支持，程序会自动转码。想同步锁屏建议选 JPG。" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="桌面壁纸填充方式" Style="{StaticResource SectionTitle}" />
                        <ComboBox ItemsSource="{Binding StyleOptions}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding DesktopStyle}"
                                  Width="320"
                                  HorizontalAlignment="Left"
                                  Margin="0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="改这里会应用到所有显示器的桌面；单块屏也可以到“桌面”页单独改。" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="壁纸库上限" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding LibraryLimit, UpdateSourceTrigger=PropertyChanged}"
                                     Width="110"
                                     Margin="0,0,10,0" />
                            <TextBlock Text="张，超出后自动删最早的（收藏不删）"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushTextDim}"
                                       FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="开机自启" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="随 Windows 登录自动启动"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="写入当前用户的启动项，关掉就删除；定时换壁纸需要程序一直运行，开机自启能省得每次手动开。" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding AppVersion, StringFormat='MintWall {0}'}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="WPF + SkiaSharp，桌面走 SystemParametersInfo / IDesktopWallpaper，锁屏走 Windows.System.UserProfile.LockScreen。" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="免安装即可运行；MSIX 版本用同一份产物打包。" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
