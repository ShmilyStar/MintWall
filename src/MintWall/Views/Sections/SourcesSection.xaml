<UserControl x:Class="MintWall.Views.Sections.SourcesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource Card}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}"
                               Text="{Binding Title, StringFormat=壁纸源 · {0}}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="这里的源只属于本目标，和另一个目标互不共用。" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="从桌面复制"
                            Margin="0,0,8,0"
                            Command="{Binding CopySourcesFromDesktopCommand}"
                            Visibility="{Binding IsLock, Converter={StaticResource BoolToVis}}" />
                    <Button Content="添加源"
                            Style="{StaticResource AccentButton}"
                            Margin="0"
                            Command="{Binding AddSourceCommand}" />
                </StackPanel>
            </Grid>

            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="编辑" Margin="0,0,8,0" Command="{Binding EditSourceCommand}" />
                <Button Grid.Column="1"
                        Content="设为当前"
                        Margin="0,0,8,0"
                        Command="{Binding ActivateSourceCommand}"
                        CommandParameter="{Binding SelectedSource}" />
                <Button Grid.Column="2" Content="测试此源" Margin="0,0,8,0" Command="{Binding TestSourceCommand}" />
                <Button Grid.Column="3"
                        Content="删除"
                        Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Right"
                        Margin="0"
                        Command="{Binding RemoveSourceCommand}" />
            </Grid>

            <Grid MinHeight="150">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Inset}" Padding="6">
                    <Grid>
                        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding Url}"
                                                       Style="{StaticResource Mono}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Style="{StaticResource ChipAccent}"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding AutoSave, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="存盘" FontSize="11" TextWrapping="NoWrap" />
                                        </Border>
                                        <Border Grid.Column="2"
                                                Style="{StaticResource ChipAccent}"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="当前" FontSize="11" TextWrapping="NoWrap" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Style="{StaticResource Hint}"
                                   MaxWidth="250"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SourceCount, Converter={StaticResource CountToVis}, ConverterParameter=empty}"
                                   Text="还没有壁纸源，“换一张”会先用系统本机的 Windows 聚焦图；点右上角“添加源”就换成你自己的。" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" Margin="2,0,0,0">
                    <StackPanel Visibility="{Binding HasSelectedSource, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSource.Name}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="接口地址" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       Text="{Binding SelectedSource.Url}"
                                       Style="{StaticResource Mono}"
                                       Margin="0,0,0,6"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="解析方式" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSource.Kind}" Margin="0,0,0,6" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="JSON 字段" Style="{StaticResource FieldLabel}" />
                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                                <TextBlock Text="{Binding SelectedSource.JsonFieldPath}"
                                           Style="{StaticResource Mono}"
                                           Visibility="{Binding SelectedSource.JsonFieldPath, Converter={StaticResource TextPresentToVis}}" />
                                <TextBlock Text="留空：自动识别图片直链或常见 JSON 字段"
                                           Style="{StaticResource Hint}"
                                           Visibility="{Binding SelectedSource.JsonFieldPath, Converter={StaticResource TextMissingToVis}}" />
                            </Grid>
                        </Grid>
                        <StackPanel Margin="0,8,0,0">
                            <CheckBox Content="自动保存抓到的图"
                                      Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding SelectedSource.AutoSave}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,6,0,0"
                                       Text="开着：存进下面的“保存位置”，永久保留、不进壁纸库。关着：只放程序缓存，换下一张时旧的那张自动删掉。" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="保存位置" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border Grid.Column="1"
                                        Style="{StaticResource Inset}"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="SaveFolder_Click"
                                        ToolTip="点击选择保存位置">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SaveDirText, Mode=OneWay}"
                                                   Style="{StaticResource Mono}"
                                                   MaxWidth="330"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                        <Border Style="{StaticResource ChipAccent}"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsBuiltInSave, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="内置" FontSize="11" TextWrapping="NoWrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Content="选择目录"
                                            Margin="0,0,8,0"
                                            Command="{Binding ChooseSaveFolderCommand}" />
                                    <Button Content="恢复内置"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding IsBuiltInSave, Converter={StaticResource InverseBoolToVis}}"
                                            Command="{Binding ResetSaveFolderCommand}" />
                                    <Button Content="打开"
                                            Margin="0"
                                            Command="{Binding OpenSaveFolderCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Margin="0,8,0,0"
                                   Text="改完建议先“测试此源”，确认能取到图片再换壁纸，避免把画面换成一张错误页。" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Hint}"
                               VerticalAlignment="Center"
                               Text="在左边选一个源查看详情。"
                               Visibility="{Binding HasSelectedSource, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
