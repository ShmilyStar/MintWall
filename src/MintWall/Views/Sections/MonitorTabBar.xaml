<UserControl x:Class="MintWall.Views.Sections.MonitorTabBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 浏览器标签页样式：选中项与下方内容连成一片，未选中只留一点底色。 -->
        <Style x:Key="ScreenTab" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="shell"
                                Background="#DFF1E9"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="9,9,0,0"
                                Padding="14,7,14,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="#D2EADF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="shell" Property="Background" Value="{StaticResource BrushCard}" />
                                <Setter TargetName="shell" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,0,0,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Border BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,0,1"
                    VerticalAlignment="Bottom" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <TextBlock Text="{Binding MonitorCount, StringFormat=共 {0} 块屏}"
                           Style="{StaticResource StatLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <Button Content="重新检测"
                        Style="{StaticResource GhostButton}"
                        Margin="0"
                        Command="{Binding DataContext.RefreshAllCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Monitors}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource ScreenTab}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalAlignment="Left"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}"
                                       FontWeight="SemiBold"
                                       MaxWidth="180"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ScreenSizes}"
                                       Style="{StaticResource StatLabel}"
                                       Margin="9,2,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <TextBlock Grid.Row="1"
                   Style="{StaticResource Hint}"
                   Margin="2,8,2,0"
                   TextWrapping="Wrap"
                   Text="{Binding PerMonitorNotice}" />
    </Grid>
</UserControl>
