<UserControl x:Class="MintWall.Views.Sections.ScheduleSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource Card}">
        <!-- 左列标题、说明和开关；右列间隔与下次执行从卡片顶部往下排。 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,6"
                           Text="{Binding Title, StringFormat=定时 · {0}}" />
                <TextBlock Style="{StaticResource Hint}"
                           Margin="0,0,0,10"
                           TextWrapping="Wrap"
                           Text="{Binding ScheduleHint}" />

                <CheckBox Content="启用定时自动换壁纸"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding ScheduleEnabled}" />
                <Button Content="{Binding ExtraText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Command="{Binding ExtraCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        Visibility="{Binding ExtraText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TextPresentToVis}}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Margin="22,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <TextBlock Text="间隔（分钟）" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding ScheduleIntervalMinutes, UpdateSourceTrigger=PropertyChanged}"
                         Width="104"
                         HorizontalAlignment="Left"
                         Margin="0,4,0,6" />

                <Border Style="{StaticResource Inset}"
                        MinWidth="168"
                        Visibility="{Binding ShowNextRun, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="下一次执行" Style="{StaticResource StatLabel}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding NextRunText}" FontSize="15" FontWeight="SemiBold" TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
