<UserControl x:Class="MintWall.Views.VideoSourcesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="clr-namespace:MintWall.Views.Sections">

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="在线视频库" Style="{StaticResource PageTitle}" />
                <TextBlock Text="按显示器分开配置：每块屏的在线视频源独立；播放前会先下载到本地缓存。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <CheckBox Content="启用在线视频库"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding Desktop.Selected.Video.OnlineEnabled}" />
            </StackPanel>
        </Grid>

        <sections:MonitorTabBar Grid.Row="1" DataContext="{Binding Desktop}" />

        <Border Grid.Row="2" Style="{StaticResource Card}" DataContext="{Binding Desktop.Selected.Video}" Margin="0,0,0,14">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{Binding Title, StringFormat=视频源 · {0}}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="这里的源只属于这块屏，和别的屏互不共用；支持直链视频或返回视频地址的 JSON 接口。" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="添加"
                                Margin="0,0,8,0"
                                Command="{Binding AddSourceCommand}" />
                        <Button Content="编辑" Margin="0,0,8,0" Command="{Binding EditSourceCommand}" />
                        <Button Content="删除"
                                Style="{StaticResource DangerButton}"
                                Margin="0"
                                Command="{Binding RemoveSourceCommand}" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Inset}" Padding="6">
                        <Grid>
                            <ListBox ItemsSource="{Binding Sources}"
                                     SelectedItem="{Binding SelectedSource}"
                                     PreviewMouseRightButtonDown="SourcesList_RightClick">
                                <ListBox.ContextMenu>
                                    <ContextMenu Style="{StaticResource AppContextMenu}">
                                        <MenuItem Header="编辑"
                                                  Style="{StaticResource AppMenuItem}"
                                                  Click="EditSourceMenu_Click" />
                                        <MenuItem Header="复制"
                                                  Style="{StaticResource AppMenuItem}"
                                                  Click="CopySourceLink_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Url}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextFaint}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource ChipAccent}"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0"
                                                    Visibility="{Binding AutoSave, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="存盘" FontSize="11" TextWrapping="NoWrap" />
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource ChipWarn}"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0"
                                                    Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVis}}">
                                                <TextBlock Text="停用" FontSize="11" TextWrapping="NoWrap" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Style="{StaticResource Hint}"
                                       MaxWidth="250"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SourceCount, Converter={StaticResource CountToVis}, ConverterParameter=empty}"
                                       Text="这块屏还没有在线源，点右上角“添加”填一个视频直链或 JSON 接口。" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Margin="2,0,0,0">
                        <StackPanel Visibility="{Binding HasSelectedSource, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSource.Name}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="接口地址" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding SelectedSource.Url}"
                                           Style="{StaticResource Mono}"
                                           Margin="0,0,0,6"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           ToolTip="右键复制地址">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu Style="{StaticResource AppContextMenu}">
                                            <MenuItem Header="复制地址"
                                                      Style="{StaticResource AppMenuItem}"
                                                      Click="CopyAddress_Click" />
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="解析方式" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSource.Kind}" Margin="0,0,0,6" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="JSON 字段" Style="{StaticResource FieldLabel}" />
                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding SelectedSource.JsonFieldPath}"
                                               Style="{StaticResource Mono}"
                                               Visibility="{Binding SelectedSource.JsonFieldPath, Converter={StaticResource TextPresentToVis}}" />
                                    <TextBlock Text="留空：自动识别直链或常见 JSON 字段"
                                               Style="{StaticResource Hint}"
                                               Visibility="{Binding SelectedSource.JsonFieldPath, Converter={StaticResource TextMissingToVis}}" />
                                </Grid>
                            </Grid>
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox Content="启用此源"
                                          Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding SelectedSource.Enabled, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Margin="0,6,0,0"
                                           Text="停用后“换一张”和定时器会跳过这个源，手动点“刷新”仍然可用。" />
                                <CheckBox Content="自动保存抓到的视频"
                                          Style="{StaticResource ToggleSwitch}"
                                          Margin="0,10,0,0"
                                          IsChecked="{Binding SelectedSource.AutoSave, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Margin="0,6,0,0"
                                           Text="开着：存进下面的“保存位置”，永久保留、不进本地视频库。关着：只放缓存，换下一个时旧文件自动删掉。" />

                                <TextBlock Text="保存位置" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                                <Border Style="{StaticResource Inset}" ToolTip="自动保存的视频存放目录">
                                    <TextBlock Text="{Binding SelectedSaveDirText, Mode=OneWay}"
                                               Style="{StaticResource Mono}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="选择目录" Margin="0,0,8,0" Command="{Binding ChooseSaveFolderCommand}" />
                                    <Button Content="恢复内置"
                                            Margin="0,0,8,0"
                                            Visibility="{Binding IsBuiltInSave, Converter={StaticResource InverseBoolToVis}}"
                                            Command="{Binding ResetSaveFolderCommand}" />
                                    <Button Content="打开" Margin="0" Command="{Binding OpenSaveFolderCommand}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Hint}"
                                           Margin="0,8,0,0"
                                           Text="改完建议先点“刷新”在右侧预览，确认能取到视频再点“设置当前”或交给概览页的视频来源。" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Hint}"
                                   VerticalAlignment="Center"
                                   Text="在左边选一个源查看详情。"
                                   Visibility="{Binding HasSelectedSource, Converter={StaticResource InverseBoolToVis}}" />
                    </StackPanel>

                    <Border Grid.Column="4"
                            Style="{StaticResource Inset}"
                            Padding="10"
                            Margin="2,0,0,0"
                            Visibility="{Binding HasSelectedSource, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Stretch"
                                      Margin="0,0,8,0"
                                      Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="PreviewResolution"
                                               Grid.Row="0"
                                               Style="{StaticResource Mono}"
                                               FontSize="11"
                                               VerticalAlignment="Top" />
                                    <TextBlock x:Name="PreviewSize"
                                               Grid.Row="1"
                                               Style="{StaticResource Mono}"
                                               FontSize="11"
                                               VerticalAlignment="Bottom" />
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="刷新"
                                            Margin="0,0,8,0"
                                            Command="{Binding PlaySourceCommand}" />
                                    <Button Content="设置当前"
                                            Style="{StaticResource AccentButton}"
                                            Margin="0"
                                            Command="{Binding SetCurrentVideoCommand}" />
                                </StackPanel>
                            </Grid>

                            <Border Background="#0E1A15"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True">
                                <Grid>
                                    <MediaElement x:Name="PreviewMedia"
                                                  Source="{Binding PreviewSource}"
                                                  LoadedBehavior="Play"
                                                  UnloadedBehavior="Manual"
                                                  Volume="0"
                                                  IsMuted="True"
                                                  Stretch="Uniform"
                                                  MediaOpened="PreviewMedia_Opened"
                                                  MediaEnded="PreviewMedia_Ended"
                                                  MediaFailed="PreviewMedia_Failed" />
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="&#xE714;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="40"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   HorizontalAlignment="Center"
                                                   Opacity="0.8" />
                                        <TextBlock Text="点下面的“刷新”在框内预览，点“设置当前”才会应用到桌面壁纸。"
                                                   Foreground="#CFE9E0"
                                                   FontSize="11.5"
                                                   Margin="14,10,14,0"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
                </Border>
    </Grid>
</UserControl>
