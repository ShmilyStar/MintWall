<UserControl x:Class="MintWall.Views.DesktopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MintWall.Views"
             xmlns:sections="clr-namespace:MintWall.Views.Sections">

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="桌面" Style="{StaticResource PageTitle}" />
                <TextBlock Text="每块显示器各有一套壁纸库、保存位置、定时与样式；壁纸源和锁屏在左侧单独配置。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="换一张"
                    Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding Desktop.FetchSelectedCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource StableScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>

                <sections:MonitorTabBar DataContext="{Binding Desktop}" />

                <!-- 预览 + 应用方式在上、定时在下；预览宽度与锁屏页、概览页统一 460，几处画面一样大 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Cursor="Hand"
                                    CornerRadius="16,16,0,0"
                                    ClipToBounds="True"
                                    Background="#EAF4EF"
                                    ToolTip="点击在文件夹中打开当前这张图"
                                    MouseLeftButtonUp="Preview_Click"
                                    views:AspectFit.Ratio="{Binding Desktop.Selected.ScreenAspect}">
                                <Grid>
                                    <Image Source="{Binding Desktop.Selected.Preview}" Stretch="UniformToFill" />
                                    <TextBlock Text="还没有这块屏的壁纸预览"
                                               Foreground="{StaticResource BrushTextFaint}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Desktop.Selected.HasPreview, Converter={StaticResource InverseBoolToVis}}" />
                                    <Border Style="{StaticResource ChipAccent}" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Desktop.Selected.Label, StringFormat=桌面 · {0}}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource BrushText}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <WrapPanel Grid.Row="1" Margin="8,10,8,10">
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Style="{StaticResource StatLabel}"
                                               Text="{Binding Desktop.Selected.NextRunText, StringFormat=定时 {0}}" />
                                </Border>
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Style="{StaticResource StatLabel}"
                                               Text="{Binding Desktop.Selected.LibraryCount, StringFormat=库 {0} 张}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0">
                                    <TextBlock Style="{StaticResource StatLabel}"
                                               Text="{Binding Desktop.Selected.SourceCount, StringFormat=源 {0} 个}" />
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- 第一张卡按内容高，定时卡吸收剩余高度：两卡总高与左边预览卡齐平。 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,6"
                                           Text="{Binding Desktop.Selected.Label, StringFormat=应用方式 · {0}}" />

                                <TextBlock Text="壁纸样式" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <!-- 和锁屏页“立即设置”同结构：两列等宽，下拉框与右侧按钮各占一半。 -->
                                <UniformGrid Columns="2">
                                    <ComboBox ItemsSource="{Binding StyleOptions}"
                                              Height="34"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              SelectedValuePath="Key"
                                              SelectedValue="{Binding Desktop.Selected.Style}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Value}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <Button Content="打开系统背景设置"
                                            Height="34"
                                            Margin="6,0,0,0"
                                            Command="{Binding OpenSystemBackgroundSettingsCommand}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <sections:ScheduleSection Grid.Row="1" DataContext="{Binding Desktop.Selected}" Margin="0" />
                    </Grid>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
