<UserControl x:Class="MintWall.Views.LockScreenPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MintWall.Views"
             xmlns:sections="clr-namespace:MintWall.Views.Sections">

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="锁屏" Style="{StaticResource PageTitle}" />
                <TextBlock Text="每块显示器各有一套锁屏壁纸库和定时器，和桌面完全分开；锁屏壁纸源在左侧单独配置。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="换一张"
                    Style="{StaticResource AccentButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{Binding Lock.FetchSelectedCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Style="{StaticResource StableScrollViewer}" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>

                <sections:MonitorTabBar DataContext="{Binding Lock}" />

                <!-- 预览宽度和桌面页、概览页统一 460，几处画面一样大 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="460" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Cursor="Hand"
                                    CornerRadius="16,16,0,0"
                                    ClipToBounds="True"
                                    Background="#EAF4EF"
                                    ToolTip="点击在文件夹中打开当前这张图"
                                    MouseLeftButtonUp="Preview_Click"
                                    views:AspectFit.Ratio="{Binding Lock.Selected.ScreenAspect}">
                                <Grid>
                                    <Image Source="{Binding Lock.Selected.Preview}" Stretch="UniformToFill" />
                                    <TextBlock Text="读不到锁屏图片（可能刚开机还没写入过，或被系统聚焦接管）"
                                               Foreground="{StaticResource BrushTextFaint}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               MaxWidth="300"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Lock.Selected.HasPreview, Converter={StaticResource InverseBoolToVis}}" />
                                    <Border Style="{StaticResource Chip}" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Lock.Selected.Label, StringFormat=锁屏 · {0}}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource BrushText}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <WrapPanel Grid.Row="1" Margin="8,10,8,10">
                                <Border Style="{StaticResource Chip}">
                                    <TextBlock Style="{StaticResource StatLabel}"
                                               Text="{Binding Lock.Selected.LibraryCount, StringFormat=库 {0} 张}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0">
                                    <TextBlock Style="{StaticResource StatLabel}"
                                               Text="{Binding Lock.Selected.SourceCount, StringFormat=源 {0} 个}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding Lock.Selected.Message}"
                                       Style="{StaticResource Hint}"
                                       Margin="14,0,14,12"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding Lock.Selected.Message, Converter={StaticResource TextPresentToVis}}" />
                        </Grid>
                    </Border>

                    <!-- 第一张卡按内容高，定时卡吸收剩余高度：两卡总高与左边预览卡齐平。 -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 结构和桌面页的“应用方式”一致：标题 + 字段名 + 一行控件，两张卡自然等高。 -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}"
                                           Margin="0,0,0,6"
                                           Text="{Binding Lock.Selected.Label, StringFormat=立即设置 · {0}}" />
                                <TextBlock Text="系统锁屏" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <UniformGrid Columns="2">
                                    <Button Content="用当前桌面壁纸"
                                            Style="{StaticResource AccentButton}"
                                            Height="34"
                                            Margin="0,0,6,0"
                                            Command="{Binding PushDesktopToLockCommand}" />
                                    <Button Content="打开系统锁屏设置"
                                            Height="34"
                                            Margin="6,0,0,0"
                                            Command="{Binding OpenSystemLockSettingsCommand}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <sections:ScheduleSection Grid.Row="1" DataContext="{Binding Lock.Selected}" Margin="0" />
                    </Grid>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
