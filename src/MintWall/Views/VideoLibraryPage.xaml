<UserControl x:Class="MintWall.Views.VideoLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MintWall.Views.Controls"
             xmlns:sections="clr-namespace:MintWall.Views.Sections">

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="本地视频库" Style="{StaticResource PageTitle}" />
                <TextBlock Text="按显示器分开存放：每块屏的视频库、启用状态都独立；导入的视频会复制到数据目录。" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <CheckBox Content="启用本地视频库"
                          Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding Desktop.Selected.Video.LocalEnabled}" />
            </StackPanel>
        </Grid>

        <sections:MonitorTabBar Grid.Row="1" DataContext="{Binding Desktop}" />

        <Border Grid.Row="2" Style="{StaticResource Card}" DataContext="{Binding Desktop.Selected.Video}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="{Binding Title, StringFormat=视频库 · {0}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="目录" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding LibraryDirText, Mode=OneWay}"
                                       Style="{StaticResource Mono}"
                                       MaxWidth="520"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <Border Style="{StaticResource ChipAccent}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsBuiltInLibrary, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="内置" FontSize="11" TextWrapping="NoWrap" />
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="可以“选择目录”改成自己的视频文件夹：里面的视频（含子文件夹）直接当视频库用，能读能删，但程序不会自动清理你的文件夹。" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="选择目录" Margin="0,0,8,0" Command="{Binding ChooseLibraryFolderCommand}" />
                        <Button Content="恢复内置"
                                Margin="0,0,8,0"
                                Command="{Binding ResetLibraryFolderCommand}"
                                Visibility="{Binding IsBuiltInLibrary, Converter={StaticResource InverseBoolToVis}}" />
                        <Button Content="导入视频" Margin="0,0,8,0" Command="{Binding ImportLocalVideosCommand}" />
                        <Button Content="刷新" Margin="0,0,8,0" Command="{Binding RefreshLibraryCommand}" />
                        <Button Content="打开目录" Margin="0" Command="{Binding OpenVideoFolderCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,8,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                        <TextBlock Text="按文件名筛选"
                                   Foreground="{StaticResource BrushTextFaint}"
                                   FontSize="12.5"
                                   Margin="11,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   TextWrapping="NoWrap"
                                   Visibility="{Binding SearchText, Converter={StaticResource TextMissingToVis}}" />
                    </Grid>
                    <CheckBox Grid.Column="1"
                              Content="只看收藏"
                              IsChecked="{Binding FavoritesOnly}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextDim}"
                               FontSize="12"
                               Text="{Binding FilteredCount, StringFormat=共 {0} 个}" />
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Inset}" MinHeight="240">
                    <Grid>
                        <ListBox ItemsSource="{Binding View}"
                                 SelectedItem="{Binding SelectedLocalVideo}"
                                 ItemContainerStyle="{StaticResource ThumbItem}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingWrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="196">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Height="110" CornerRadius="7" ClipToBounds="True" Background="#EAF4EF">
                                            <Grid>
                                                <TextBlock Text="&#xE714;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="34"
                                                           Foreground="{StaticResource BrushAccent}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                <Border Background="#B32B4038"
                                                        CornerRadius="4"
                                                        Padding="5,1"
                                                        Margin="6"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding ExtensionText}"
                                                               FontSize="10.5"
                                                               Foreground="#F2FBF7"
                                                               TextWrapping="NoWrap" />
                                                </Border>
                                                <TextBlock Text="★"
                                                           FontSize="15"
                                                           Foreground="{StaticResource BrushStar}"
                                                           Margin="7,5,0,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Top"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Row="1" Margin="2,6,2,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding SizeText}"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource BrushTextDim}"
                                                       TextWrapping="NoWrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,2">
                                            <Button Style="{StaticResource IconButton}"
                                                    ToolTip="播放这块屏的视频壁纸"
                                                    Command="{Binding DataContext.PlayLocalVideoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    ToolTip="收藏 / 取消收藏"
                                                    Command="{Binding DataContext.ToggleFavoriteItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Margin="0"
                                                    ToolTip="删除这个视频"
                                                    Command="{Binding DataContext.RemoveLocalVideoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding LocalCount, Converter={StaticResource CountToVis}, ConverterParameter=empty}">
                            <TextBlock Text="这块屏的库里还没有视频"
                                       Foreground="{StaticResource BrushTextDim}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource Hint}"
                                       HorizontalAlignment="Center"
                                       Text="点“导入视频”把本地 mp4 / wmv 加进来；在线视频源下载的片子会放进缓存，不占用这里。" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
